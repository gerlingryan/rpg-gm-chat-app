generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id         String      @id @default(cuid())
  title      String
  ruleset    String
  chatModel  String      @default("gpt-4o-mini")
  bootstrapVersion Int   @default(1)
  bootstrapJson Json?
  progressionStateJson Json?
  progressionEventsJson Json?
  partyStateJson Json?
  mapStateJson Json?
  worldMapJson Json?
  worldMapHistoryJson Json?
  sceneImageHistoryJson Json?
  combatStateJson Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  characters Character[]
  messages   Message[]
}

model LibraryCharacter {
  id              String      @id @default(cuid())
  name            String
  ruleset         String
  role            String      @default("player")
  sheetJson       Json
  memorySummary   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  campaignCopies  Character[] @relation("CampaignCharacterOrigin")
}

model Character {
  id                     String            @id @default(cuid())
  campaignId             String
  campaign               Campaign          @relation(fields: [campaignId], references: [id])
  originLibraryCharacterId String?
  originLibraryCharacter LibraryCharacter? @relation("CampaignCharacterOrigin", fields: [originLibraryCharacterId], references: [id])
  name                   String
  role                   String            // player, companion, npc
  sheetJson              Json
  memorySummary          String?
  isMainCharacter        Boolean           @default(false)

  @@index([campaignId])
}

model Message {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  speakerName String
  role        String   // user, gm, companion
  content     String
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

model BattleMapTemplate {
  id               String   @id @default(cuid())
  ruleset          String
  locationKey      String
  title            String
  imageDataUrl     String?
  referenceUrl     String?
  gridCols         Int
  gridRows         Int
  tileSizePx       Int      @default(64)
  blockedTilesJson Json
  playerSpawnTilesJson Json
  enemySpawnTilesJson  Json
  tagsJson         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ruleset, locationKey])
  @@index([createdAt])
}

model TokenLibraryEntry {
  id            String   @id @default(cuid())
  entityType    String
  ruleset       String
  category      String   @default("general")
  subtype       String?
  normalizedKey String
  label         String
  style         String
  imageDataUrl  String
  sourcePrompt  String?
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ruleset, normalizedKey, style])
  @@index([entityType, ruleset])
  @@index([ruleset, category, subtype])
  @@index([createdAt])
}

model CreatureLibraryEntry {
  id               String   @id @default(cuid())
  ruleset          String
  source           String   @default("open5e")
  sourceId         String
  slug             String
  name             String
  aliasesJson      Json?
  size             String?
  creatureType     String?
  subtype          String?
  alignment        String?
  acJson           Json?
  hpFormula        String?
  hpAvg            Int?
  speedJson        Json?
  abilityModsJson  Json?
  attackProfilesJson Json?
  cr               String?
  xpDerived        Int?
  tagsJson         Json?
  rawJson          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ruleset, source, sourceId])
  @@unique([ruleset, slug])
  @@index([ruleset, creatureType, cr])
  @@index([name])
}
